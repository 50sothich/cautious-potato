{
  "manifest_version": 3,
  "name": "ViturAI Ethics Judge",
  "version": "1.1",
  "description": "Evaluate AI responses ethically via ViturAI backend.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ViturAI Ethics Judge"
  },
  "host_permissions": [
    "*://*.ngrok-free.dev/*",
    "*://*.ngrok-free.app/*",
    "*://*.trycloudflare.com/*"
  ],
  "permissions": ["storage"]
}
